<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/PasoTitulo" android:text="2. Visita" />
        <TextView style="@style/PasoAyuda" android:text="La fecha y hora se toman del teléfono; puede corregirlas." />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLecturaVisita"
            style="@style/CampoTexto"
            android:hint="Lectura al momento de la visita *">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLecturaVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="9"
                android:textSize="22sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvAdvertenciaLectura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/warning"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView style="@style/PasoEtiqueta" android:text="Fecha y hora de la visita *" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFecha"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:icon="@android:drawable/ic_menu_my_calendar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHora"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:icon="@android:drawable/ic_menu_recent_history" />
        </LinearLayout>

        <TextView style="@style/PasoEtiqueta" android:text="Informe de visita: medidor *" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
